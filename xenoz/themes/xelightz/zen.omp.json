{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "palette": {
    "background": "#f5f4ef",
    "surface": "#eae7df",
    "foreground": "#1e2129",
    "muted": "#828794",
    "accent": "#3b5998",
    "accent_secondary": "#0f766e",
    "border": "#cfc9b8",
    "selection": "#d8d3c5"
  },
  "blocks": [
    {
      "alignment": "left",
      "segments": [
        {
          "background": "p:surface",
          "foreground": "p:accent",
          "leading_diamond": "\ue0b6",
          "style": "diamond",
          "template": " {{ .Path }} ",
          "type": "path"
        },
        {
          "background": "p:surface",
          "foreground": "p:foreground",
          "style": "diamond",
          "template": " {{ if .UpstreamIcon }}{{ .UpstreamIcon }}{{ end }}{{ .HEAD }}{{ if .Working.Changed }}*{{ end }} ",
          "trailing_diamond": "\ue0b4",
          "type": "git"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "foreground": "p:accent",
          "style": "plain",
          "template": "$ ",
          "type": "text"
        }
      ],
      "type": "prompt"
    }
  ],
  "transient_prompt": {
    "background": "transparent",
    "foreground": "p:accent",
    "template": "$ "
  },
  "final_space": true,
  "version": 2
}
