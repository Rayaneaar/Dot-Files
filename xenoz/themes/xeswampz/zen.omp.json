{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "palette": {
    "background": "#070a08",
    "surface": "#101712",
    "foreground": "#e0ebe2",
    "muted": "#506655",
    "accent": "#34d399",
    "accent_secondary": "#6ee7b7",
    "border": "#243b2a",
    "selection": "#1c2b20"
  },
  "blocks": [
    {
      "alignment": "left",
      "segments": [
        {
          "background": "p:surface",
          "foreground": "p:accent",
          "leading_diamond": "\ue0b6",
          "style": "diamond",
          "template": " {{ .Path }} ",
          "type": "path"
        },
        {
          "background": "p:surface",
          "foreground": "p:foreground",
          "style": "diamond",
          "template": " {{ if .UpstreamIcon }}{{ .UpstreamIcon }}{{ end }}{{ .HEAD }}{{ if .Working.Changed }}*{{ end }} ",
          "trailing_diamond": "\ue0b4",
          "type": "git"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "foreground": "p:accent",
          "style": "plain",
          "template": "$ ",
          "type": "text"
        }
      ],
      "type": "prompt"
    }
  ],
  "transient_prompt": {
    "background": "transparent",
    "foreground": "p:accent",
    "template": "$ "
  },
  "final_space": true,
  "version": 2
}
