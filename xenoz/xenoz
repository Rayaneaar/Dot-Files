// 4. Random Command
async function commandRandom(themes) {
  const current = themes.find(t => t.isActive);
  const candidates = themes.filter(t => !t.isActive);
  const pool = candidates.length > 0 ? candidates : themes;

  if (process.stdout.isTTY) {
    process.stdout.write(HIDE_CURSOR);
    const frames = 12;
    for (let i = 0; i < frames; i++) {
      const pick = pool[Math.floor(Math.random() * pool.length)];
      const spinIcon = ['◓', '◑', '◒', '◐'][i % 4];
      process.stdout.write(`${CLEAR_LINE}  ${fgHex(pick.colors.accent, spinIcon)} ${BOLD}Rolling themes...${RESET} ${fgHex(pick.colors.accent, pick.title)}`);
      await new Promise(r => setTimeout(r, 35 + i * 10));
    }
    process.stdout.write(`${CLEAR_LINE}`);
    process.stdout.write(SHOW_CURSOR);
  }

  const chosen = pool[Math.floor(Math.random() * pool.length)];
  console.log(`\n  ${BOLD}🎲 Selected:${RESET} ${fgHex(chosen.colors.accent, chosen.title)} ${DIM}(${chosen.id})${RESET}`);
  await applyTheme(chosen);
}

// 5. Next / Previous Command
async function commandCycle(direction, themes) {
  const currentIdx = themes.findIndex(t => t.isActive);
  let nextIdx = 0;
  if (currentIdx !== -1) {
    nextIdx = direction === 'next'
      ? (currentIdx + 1) % themes.length
      : (currentIdx - 1 + themes.length) % themes.length;
  }
  const chosen = themes[nextIdx];
  await applyTheme(chosen);
}

