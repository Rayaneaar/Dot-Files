// --- Core Theme Loader ---
function loadThemes() {
  if (!fs.existsSync(THEMES_DIR)) {
    return [];
  }

  const dirs = fs.readdirSync(THEMES_DIR).filter(f => {
    const p = path.join(THEMES_DIR, f);
    return fs.statSync(p).isDirectory();
  }).sort();

  let activeTheme = null;
  if (fs.existsSync(CURRENT_LINK)) {
    try {
      const target = fs.readlinkSync(CURRENT_LINK);
      activeTheme = path.basename(target);
    } catch (_) {}
  }

  return dirs.map((id, index) => {
    const themeDir = path.join(THEMES_DIR, id);
    const colors = {
      name: id,
      background: '#141414',
      surface: '#242424',
      foreground: '#e0e0e0',
      muted: '#666666',
      accent: '#bb86fc',
      accent_secondary: '#03dac6',
      border: '#333333',
      selection: '#2c2c34'
    };

    // Parse colors.lua
    const luaPath = path.join(themeDir, 'colors.lua');
    if (fs.existsSync(luaPath)) {
      const content = fs.readFileSync(luaPath, 'utf8');
      const matches = content.matchAll(/([a-zA-Z0-9_]+)\s*=\s*["'](#?[a-zA-Z0-9]+)["']/g);
      for (const m of matches) {
        colors[m[1]] = m[2].startsWith('#') ? m[2] : `#${m[2]}`;
      }
    }

    // Parse theme.conf for fallback / kitty specific
    const confPath = path.join(themeDir, 'theme.conf');
    if (fs.existsSync(confPath)) {
      const confLines = fs.readFileSync(confPath, 'utf8').split('\n');
      for (const line of confLines) {
        const trimmed = line.trim();
        if (!trimmed || trimmed.startsWith('#')) continue;
        const [key, val] = trimmed.split(/\s+/);
        if (key === 'background' && val) colors.background = val;
        if (key === 'foreground' && val) colors.foreground = val;
        if (key === 'cursor' && val && !colors.accent) colors.accent = val;
        if (key === 'active_border_color' && val && !colors.border) colors.border = val;
      }
    }

    // Find wallpaper
    let wallpaper = null;
    const candidates = [
      `${id}.png`, `${id}.jpg`, `${id}.jpeg`, `${id}.webp`,
      'wallpaper.png', 'wallpaper.jpg', 'wallpaper.jpeg', 'wallpaper.webp'
    ];
    for (const c of candidates) {
      const wp = path.join(themeDir, c);
      if (fs.existsSync(wp)) {
        wallpaper = wp;
        break;
      }
    }
    if (!wallpaper) {
      try {
        const anyImg = fs.readdirSync(themeDir).find(f => /\.(png|jpg|jpeg|webp)$/i.test(f));
        if (anyImg) wallpaper = path.join(themeDir, anyImg);
      } catch (_) {}
    }

    const preset = THEME_PRESETS[id] || {
      title: id.replace(/^xe/, '').replace(/z$/, '').toUpperCase() || id,
      desc: 'Custom XENOZ Theme',
      gradient: [colors.accent || '#a855f7', colors.accent_secondary || '#3b82f6']
    };

    return {
      id,
      index: index + 1,
      path: themeDir,
      colors,
      wallpaper,
      title: preset.title,
      desc: preset.desc,
      gradient: preset.gradient,
      isActive: id === activeTheme
    };
  });
}

function resolveTheme(input, themes) {
  if (!input) return null;
  const clean = input.trim().toLowerCase();

  // Exact ID match
  let found = themes.find(t => t.id.toLowerCase() === clean);
  if (found) return found;

  // Number index match (1-based)
  const num = parseInt(clean, 10);
  if (!isNaN(num) && num >= 1 && num <= themes.length) {
    return themes[num - 1];
  }

  // Alias match without 'xe' or 'z' (e.g. 'ocean' -> 'xeoceanz', 'dark' -> 'xedarkz')
  found = themes.find(t => {
    const stripped = t.id.replace(/^xe/, '').replace(/z$/, '').toLowerCase();
    return stripped === clean;
  });
  if (found) return found;

  // Substring / prefix match
  found = themes.find(t => t.id.toLowerCase().includes(clean) || t.title.toLowerCase().includes(clean));
  return found || null;
}

// --- Dynamic Switch Execution ---
async function applyTheme(themeObj, options = {}) {
  const startTime = Date.now();
  const theme = themeObj.id;
  const targetDir = themeObj.path;
  const isSilent = options.silent || false;
  const isTTY = process.stdout.isTTY && !isSilent;

  const steps = [
    { name: 'Core Symlinks', status: 'pending', desc: 'Symlinking ~/.config/xenoz/current' },
    { name: 'Kitty Terminal', status: 'pending', desc: 'Broadcasting SIGUSR1 reload' },
    { name: 'Neovim RPC', status: 'pending', desc: 'Updating active Neovim server sockets' },
    { name: 'Oh My Posh', status: 'pending', desc: 'Linking prompt theme config' },
    { name: 'macOS Wallpaper', status: 'pending', desc: 'Updating desktop picture via System Events' },
    { name: 'SketchyBar & Borders', status: 'pending', desc: 'Synchronizing dynamic status bar' }
  ];

  // 1. Core Symlink
  const doSymlink = async () => {
    const tmpLink = CURRENT_LINK + '.tmp.' + Date.now();
    try {
      if (fs.existsSync(tmpLink)) fs.unlinkSync(tmpLink);
      fs.symlinkSync(`themes/${theme}`, tmpLink);
      fs.renameSync(tmpLink, CURRENT_LINK);
      return { ok: true, msg: 'Theme linked' };
    } catch (e) {
      try {
        if (fs.existsSync(CURRENT_LINK) || fs.lstatSync(CURRENT_LINK).isSymbolicLink()) {
          fs.unlinkSync(CURRENT_LINK);
        }
        fs.symlinkSync(`themes/${theme}`, CURRENT_LINK);
        return { ok: true, msg: 'Theme linked' };
      } catch (err2) {
        return { ok: false, msg: err2.message };
      }
    }
  };

  // 2. Kitty Reload
  const doKitty = async () => {
    return new Promise((resolve) => {
      if (fs.existsSync(KITTY_CONF)) {
        try {
          const now = new Date();
          fs.utimesSync(KITTY_CONF, now, now);
        } catch (_) {}
      }
      exec('pkill -USR1 -f kitty', (err) => {
        resolve({ ok: true, msg: err ? 'Updated (will apply on launch)' : 'Reloaded via SIGUSR1' });
      });
    });
  };

  // 3. Neovim RPC Sockets
  const doNvim = async () => {
    return new Promise((resolve) => {
      const tmpDirs = [process.env.TMPDIR, '/tmp', '/var/tmp'].filter(Boolean);
      let sockets = [];
      for (const t of tmpDirs) {
        try {
          const files = fs.readdirSync(t);
          for (const f of files) {
            if (f.startsWith('nvim')) {
              const full = path.join(t, f);
              try {
                if (fs.statSync(full).isSocket()) sockets.push(full);
              } catch (_) {}
            }
          }
        } catch (_) {}
      }

      if (sockets.length === 0) {
        return resolve({ ok: true, msg: 'No active instances (ready on start)' });
      }

      let count = 0;
      let completed = 0;
      for (const sock of sockets) {
        count++;
        exec(`nvim --server "${sock}" --remote-send "<Cmd>lua require('xenoz').apply()<CR>"`, () => {
          completed++;
          if (completed === count) {
            resolve({ ok: true, msg: `Updated ${count} running socket${count > 1 ? 's' : ''}` });
          }
        });
      }
    });
  };

  // 4. Oh My Posh
  const doPosh = async () => {
    return new Promise((resolve) => {
      const poshDir = path.dirname(POSH_CONF);
      if (!fs.existsSync(poshDir)) {
        return resolve({ ok: true, msg: 'Directory not found (skipped)' });
      }
      const targetPosh = path.join(CURRENT_LINK, 'zen.omp.json');
      try {
        if (fs.existsSync(POSH_CONF) || fs.lstatSync(POSH_CONF).isSymbolicLink()) {
          fs.unlinkSync(POSH_CONF);
        }
        fs.symlinkSync(targetPosh, POSH_CONF);
        const now = new Date();
        fs.utimesSync(POSH_CONF, now, now);
        resolve({ ok: true, msg: 'Prompt theme updated' });
      } catch (e) {
        resolve({ ok: false, msg: e.message });
      }
    });
  };

  // 5. Wallpaper Switch
  const doWallpaper = async () => {
    return new Promise((resolve) => {
      if (!themeObj.wallpaper || !fs.existsSync(themeObj.wallpaper)) {
        return resolve({ ok: true, msg: 'No wallpaper file (skipped)' });
      }
      const wpAbs = path.resolve(themeObj.wallpaper);
      const script = `osascript -e 'tell application "System Events" to tell every desktop to set picture to "${wpAbs}"'`;
      exec(script, (err) => {
        if (err) {
          exec(`osascript -e 'tell application "System Events" to set picture of current desktop to "${wpAbs}"'`, (err2) => {
            resolve({ ok: !err2, msg: err2 ? 'Wallpaper set failed' : path.basename(wpAbs) });
          });
        } else {
          resolve({ ok: true, msg: path.basename(wpAbs) });
        }
      });
    });
  };

  // 6. SketchyBar & Borders
  const doSketchybar = async () => {
    return new Promise((resolve) => {
      exec('pgrep -x sketchybar', (err, stdout) => {
        if (err || !stdout.trim()) {
          return resolve({ ok: true, msg: 'Not currently running' });
        }
        if (fs.existsSync(SKETCHYBAR_SCRIPT)) {
          const cacheWp = path.join(path.dirname(SKETCHYBAR_SCRIPT), 'current.wallpaper');
          try { fs.unlinkSync(cacheWp); } catch (_) {}
          exec(`bash "${SKETCHYBAR_SCRIPT}"`, (err2) => {
            resolve({ ok: !err2, msg: 'Bar & borders refreshed' });
          });
        } else {
          resolve({ ok: true, msg: 'Script not found' });
        }
      });
    });
  };

  // Spinner logic
  const spinnerFrames = ['⠋', '⠙', '⠹', '⠸', '⠼', '⠴', '⠦', '⠧', '⠇', '⠏'];
  let frameIdx = 0;
  let animInterval = null;

  const getLines = (final = false) => {
    const lines = [];
    const accent = themeObj.colors.accent || '#a855f7';
    const sec = themeObj.colors.accent_secondary || '#38bdf8';

    lines.push('');
    lines.push(`  ${BOLD}${gradientText('✦ SWITCHING THEME ✦', accent, sec)}${RESET}  ${DIM}→${RESET}  ${BOLD}${fgHex(accent, themeObj.title)}${RESET} ${DIM}(${themeObj.id})${RESET}`);
    lines.push('');

    for (const step of steps) {
      let icon = '';
      let statusText = '';
      if (step.status === 'done') {
        icon = fgHex('#22c55e', '✔');
        statusText = fgHex('#a1a1aa', step.resultMsg || step.desc);
      } else if (step.status === 'failed') {
        icon = fgHex('#ef4444', '✖');
        statusText = fgHex('#ef4444', step.resultMsg || 'Failed');
      } else {
        const frame = spinnerFrames[frameIdx % spinnerFrames.length];
        icon = fgHex(accent, frame);
        statusText = fgHex('#71717a', step.desc);
      }
      lines.push(`   ${icon}  ${BOLD}${step.name.padEnd(22)}${RESET} ${statusText}`);
    }

    if (final) {
      const elapsed = Date.now() - startTime;
      lines.push('');
      lines.push(`  ╭──────────────────────────────────────────────────────────────╮`);
      lines.push(`  │  ${fgHex('#22c55e', '●')}  ${BOLD}Theme synchronized in ${elapsed}ms${RESET}${' '.repeat(Math.max(1, 35 - String(elapsed).length))}│`);
      lines.push(`  │  Palette:  ${renderPaletteBar(themeObj.colors)}                 │`);
      lines.push(`  ╰──────────────────────────────────────────────────────────────╯`);
      lines.push('');
    }

    return lines;
  };

  const totalLines = steps.length + 4;

  if (isTTY) {
    process.stdout.write(HIDE_CURSOR);
    process.stdout.write('\n'.repeat(totalLines));
    animInterval = setInterval(() => {
      frameIdx++;
      process.stdout.write(`${ESC}${totalLines}A`);
      process.stdout.write(getLines(false).join('\n') + '\n');
    }, 60);
  }

  // Execute all tasks in parallel
  const tasks = [
    doSymlink().then(r => { steps[0].status = r.ok ? 'done' : 'failed'; steps[0].resultMsg = r.msg; }),
    doKitty().then(r => { steps[1].status = r.ok ? 'done' : 'failed'; steps[1].resultMsg = r.msg; }),
    doNvim().then(r => { steps[2].status = r.ok ? 'done' : 'failed'; steps[2].resultMsg = r.msg; }),
    doPosh().then(r => { steps[3].status = r.ok ? 'done' : 'failed'; steps[3].resultMsg = r.msg; }),
    doWallpaper().then(r => { steps[4].status = r.ok ? 'done' : 'failed'; steps[4].resultMsg = r.msg; }),
    doSketchybar().then(r => { steps[5].status = r.ok ? 'done' : 'failed'; steps[5].resultMsg = r.msg; })
  ];

  await Promise.allSettled(tasks);

  if (animInterval) clearInterval(animInterval);

  if (isTTY) {
    process.stdout.write(`${ESC}${totalLines}A`);
    process.stdout.write(getLines(true).join('\n') + '\n');
    process.stdout.write(SHOW_CURSOR);
  } else if (!isSilent) {
    // Single clean output for non-TTY
    console.log(getLines(true).join('\n'));
  }

  return { ok: true, duration: Date.now() - startTime };
}

// --- Visual Formatting & Components ---
function renderPaletteBar(colors) {
  const swatches = [
    colors.background,
    colors.surface,
    colors.accent,
    colors.accent_secondary,
    colors.foreground
  ].filter(Boolean);

  return swatches.map(hex => `${fgHex(hex, '████')}`).join(' ');
}

function renderColorPills(colors) {
  const items = [
    { label: 'BG', hex: colors.background },
    { label: 'SFC', hex: colors.surface },
    { label: 'ACC', hex: colors.accent },
    { label: 'SEC', hex: colors.accent_secondary },
    { label: 'FG', hex: colors.foreground }
  ].filter(it => it.hex);

  return items.map(it => {
    const textCol = getContrastColor(it.hex);
    return `${bgHex(it.hex, fgHex(textCol, ` ${it.label} `))}`;
  }).join(' ');
}

function getHeaderBanner(themeObj) {
  const g1 = themeObj ? themeObj.gradient[0] : '#c084fc';
  const g2 = themeObj ? themeObj.gradient[1] : '#38bdf8';

  const ascii = [
    `  ██╗  ██╗███████╗███╗   ██╗ ██████╗ ███████╗`,
    `  ╚██╗██╔╝██╔════╝████╗  ██║██╔═══██╗╚══███╔╝`,
    `   ╚███╔╝ █████╗  ██╔██╗ ██║██║   ██║  ███╔╝ `,
    `   ██╔██╗ ██╔══╝  ██║╚██╗██║██║   ██║ ███╔╝  `,
    `  ██╔╝ ██╗███████╗██║ ╚████║╚██████╔╝███████╗`,
    `  ╚═╝  ╚═╝╚══════╝╚═╝  ╚═══╝ ╚═════╝ ╚══════╝`
  ];

  const renderedLogo = ascii.map((line, idx) => {
    const factor = idx / (ascii.length - 1);
    const col = interpolateColor(g1, g2, factor);
    return `${BOLD}${fgHex(col, line)}${RESET}`;
  }).join('\n');

  const subtitle = `     ${DIM}✦  C Y B E R - A E S T H E T I C   T H E M E   E N G I N E  ✦${RESET}`;
  return `\n${renderedLogo}\n${subtitle}\n`;
}

