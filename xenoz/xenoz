// 3. Preview Command
function commandPreview(themeName, themes) {
  const theme = resolveTheme(themeName, themes);
  if (!theme) {
    console.log(`\n  ${fgHex('#ef4444', '✖')} Theme '${themeName}' not found.\n`);
    return;
  }

