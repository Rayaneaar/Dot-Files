// --- Interactive TUI Theme Selector ---
async function runInteractive(themes) {
  if (!process.stdin.isTTY || !process.stdout.isTTY) {
    commandList(themes);
    return;
  }

  let selectedIndex = themes.findIndex(t => t.isActive);
  if (selectedIndex === -1) selectedIndex = 0;

  readline.emitKeypressEvents(process.stdin);
  process.stdin.setRawMode(true);
  process.stdout.write(HIDE_CURSOR);

  const cleanup = () => {
    process.stdout.write(SHOW_CURSOR);
    if (process.stdin.isTTY) {
      try { process.stdin.setRawMode(false); } catch (_) {}
    }
    process.stdin.pause();
  };

  const renderUI = () => {
    const lines = [];
    const selTheme = themes[selectedIndex];

    lines.push(getHeaderBanner(selTheme));
    lines.push(`  ${BOLD}✦ INTERACTIVE THEME SELECTOR ✦${RESET}  ${DIM}(Use ↑/↓ or j/k to navigate, Enter to apply)${RESET}\n`);

    // Render list
    for (let i = 0; i < themes.length; i++) {
      const t = themes[i];
      const isSelected = i === selectedIndex;
      const isAct = t.isActive;

      let prefix = '    ';
      let tag = '';
      if (isSelected) {
        prefix = `  ${BOLD}${fgHex(t.colors.accent, '❯❯')}${RESET} `;
      }

      if (isAct) {
        tag = ` ${bgHex('#22c55e', fgHex('#000000', ' ACTIVE '))}`;
      }

      const numStr = `${DIM}${t.index}.${RESET}`;
      const titleStr = isSelected
        ? `${BOLD}${UNDERLINE}${fgHex(t.colors.accent, t.title.padEnd(16))}${RESET}`
        : `${BOLD}${fgHex('#d4d4d8', t.title.padEnd(16))}${RESET}`;
      const idStr = `${DIM}(${t.id})${RESET}`.padEnd(16);
      const swatches = renderPaletteBar(t.colors);

      lines.push(`${prefix}${numStr} ${titleStr} ${idStr} ${swatches}${tag}`);
    }

    // Dynamic Preview Box
    lines.push('');
    const borderCol = selTheme.colors.accent || '#a855f7';
    lines.push(`  ${fgHex(borderCol, '╭─ Preview: ' + selTheme.title + ' ' + '─'.repeat(Math.max(2, 45 - selTheme.title.length)) + '╮')}`);
    lines.push(`  ${fgHex(borderCol, '│')}  ${DIM}Vibe:${RESET}      ${fgHex('#e4e4e7', selTheme.desc.padEnd(46))} ${fgHex(borderCol, '│')}`);
    lines.push(`  ${fgHex(borderCol, '│')}  ${DIM}Palette:${RESET}   ${renderColorPills(selTheme.colors)}        ${fgHex(borderCol, '│')}`);
    const wpFile = selTheme.wallpaper ? path.basename(selTheme.wallpaper) : 'None';
    lines.push(`  ${fgHex(borderCol, '│')}  ${DIM}Wallpaper:${RESET} ${fgHex('#38bdf8', wpFile.padEnd(46))} ${fgHex(borderCol, '│')}`);
    lines.push(`  ${fgHex(borderCol, '╰─────────────────────────────────────────────────────────────╯')}`);

    // Controls footer
    lines.push(`  ${DIM}[↑/↓/j/k] Navigate   [Enter/Space] Apply   [r] Random   [1-${themes.length}] Pick   [q/Esc] Quit${RESET}\n`);

    process.stdout.write(CLEAR_SCREEN);
    process.stdout.write(lines.join('\n'));
  };

  renderUI();

  return new Promise((resolve) => {
    const onKeypress = async (str, key) => {
      if (!key) return;

      // Exit keys
      if (key.name === 'q' || key.name === 'escape' || (key.ctrl && key.name === 'c')) {
        cleanup();
        process.stdout.write(CLEAR_SCREEN);
        console.log(`\n  ${DIM}Theme selection cancelled.${RESET}\n`);
        process.stdin.removeListener('keypress', onKeypress);
        return resolve();
      }

      // Navigation: Up / k / p
      if (key.name === 'up' || key.name === 'k' || key.name === 'p') {
        selectedIndex = (selectedIndex - 1 + themes.length) % themes.length;
        renderUI();
        return;
      }

      // Navigation: Down / j / n
      if (key.name === 'down' || key.name === 'j' || key.name === 'n') {
        selectedIndex = (selectedIndex + 1) % themes.length;
        renderUI();
        return;
      }

      // Random: r
      if (key.name === 'r') {
        cleanup();
        process.stdout.write(CLEAR_SCREEN);
        process.stdin.removeListener('keypress', onKeypress);
        await commandRandom(themes);
        return resolve();
      }

      // Number keys 1-9
      const num = parseInt(str, 10);
      if (!isNaN(num) && num >= 1 && num <= themes.length) {
        selectedIndex = num - 1;
        renderUI();
        return;
      }

      // Selection: Enter or Space
      if (key.name === 'return' || key.name === 'space') {
        cleanup();
        process.stdout.write(CLEAR_SCREEN);
        process.stdin.removeListener('keypress', onKeypress);
        const chosen = themes[selectedIndex];
        await applyTheme(chosen);
        return resolve();
      }
    };

    process.stdin.on('keypress', onKeypress);
  });
}

// --- Main Entrypoint ---
async function main() {
  const args = process.argv.slice(2);
  const themes = loadThemes();

  if (themes.length === 0) {
    console.log(`\n  ${fgHex('#ef4444', '✖')} No themes found in: ${THEMES_DIR}\n`);
    process.exit(1);
  }

  const firstArg = args[0] ? args[0].toLowerCase() : '';

  if (!firstArg) {
    await runInteractive(themes);
    return;
  }

  if (firstArg === '-h' || firstArg === '--help' || firstArg === 'help') {
    commandHelp();
    return;
  }

  if (firstArg === '-v' || firstArg === '--version' || firstArg === 'version') {
    console.log(`\n  ✦ ${BOLD}XENOZ Theme Engine${RESET} ${DIM}v2.0.0${RESET} (Ultra-Fast Edition)\n`);
    return;
  }

  if (firstArg === 'list' || firstArg === 'ls' || firstArg === '-l') {
    commandList(themes);
    return;
  }

  if (firstArg === 'current' || firstArg === 'status' || firstArg === 'info' || firstArg === '-c') {
    commandCurrent(themes);
    return;
  }

  if (firstArg === 'random' || firstArg === 'rand' || firstArg === '-r') {
    await commandRandom(themes);
    return;
  }

  if (firstArg === 'next' || firstArg === '-n') {
    await commandCycle('next', themes);
    return;
  }

  if (firstArg === 'prev' || firstArg === 'previous' || firstArg === '-p') {
    await commandCycle('prev', themes);
    return;
  }

  if (firstArg === 'preview') {
    const target = args[1];
    if (!target) {
      console.log(`\n  ${fgHex('#ef4444', '✖')} Please specify a theme to preview. (e.g. xenoz preview ocean)\n`);
      process.exit(1);
    }
    commandPreview(target, themes);
    return;
  }

  if (firstArg === 'reload') {
    const current = themes.find(t => t.isActive) || themes[0];
    console.log(`\n  ${BOLD}✦ Reloading current theme:${RESET} ${fgHex(current.colors.accent, current.title)}`);
    await applyTheme(current);
    return;
  }

  if (firstArg === 'switch' || firstArg === 'set' || firstArg === 'use') {
    const target = args[1];
    if (!target) {
      await runInteractive(themes);
      return;
    }
    const themeObj = resolveTheme(target, themes);
    if (!themeObj) {
      console.log(`\n  ${fgHex('#ef4444', '✖')} Theme '${target}' not found.`);
      console.log(`  ${DIM}Run 'xenoz list' to see all available themes.${RESET}\n`);
      process.exit(1);
    }
    await applyTheme(themeObj);
    return;
  }

  // Direct theme switch fallback (e.g. `xenoz ocean`, `xenoz xeamethystz`, `xenoz 3`)
  const themeObj = resolveTheme(firstArg, themes);
  if (themeObj) {
    await applyTheme(themeObj);
    return;
  }

  console.log(`\n  ${fgHex('#ef4444', '✖')} Unknown theme or command: '${firstArg}'`);
  console.log(`  ${DIM}Try 'xenoz --help' or 'xenoz list'${RESET}\n`);
  process.exit(1);
}

main().catch(err => {
  console.error('\n  Unexpected error:', err.message);
  process.exit(1);
});
