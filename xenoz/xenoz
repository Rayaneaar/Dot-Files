// --- ANSI & Styling Helpers ---
const ESC = '\x1b[';
const RESET = `${ESC}0m`;
const BOLD = `${ESC}1m`;
const DIM = `${ESC}2m`;
const ITALIC = `${ESC}3m`;
const UNDERLINE = `${ESC}4m`;
const HIDE_CURSOR = `${ESC}?25l`;
const SHOW_CURSOR = `${ESC}?25h`;
const CLEAR_SCREEN = `${ESC}2J${ESC}H`;
const CLEAR_LINE = `${ESC}2K\r`;

function hexToRgb(hex) {
  if (!hex) return [200, 200, 200];
  let h = String(hex).replace('#', '').trim();
  if (h.length === 3) h = h.split('').map(c => c + c).join('');
  const num = parseInt(h, 16);
  if (isNaN(num)) return [200, 200, 200];
  return [(num >> 16) & 255, (num >> 8) & 255, num & 255];
}

function rgbToHex(r, g, b) {
  return '#' + [r, g, b].map(x => Math.max(0, Math.min(255, Math.round(x))).toString(16).padStart(2, '0')).join('');
}

function fgHex(hex, text) {
  const [r, g, b] = hexToRgb(hex);
  return `${ESC}38;2;${r};${g};${b}m${text}${RESET}`;
}

function bgHex(hex, text) {
  const [r, g, b] = hexToRgb(hex);
  return `${ESC}48;2;${r};${g};${b}m${text}${RESET}`;
}

function getLuminance(hex) {
  const [r, g, b] = hexToRgb(hex);
  return 0.299 * r + 0.587 * g + 0.114 * b;
}

function getContrastColor(hex) {
  return getLuminance(hex) > 135 ? '#101014' : '#f8f8fc';
}

function interpolateColor(hex1, hex2, factor) {
  const [r1, g1, b1] = hexToRgb(hex1);
  const [r2, g2, b2] = hexToRgb(hex2);
  const r = r1 + factor * (r2 - r1);
  const g = g1 + factor * (g2 - g1);
  const b = b1 + factor * (b2 - b1);
  return rgbToHex(r, g, b);
}

function gradientText(text, hexStart, hexEnd) {
  const chars = Array.from(text);
  if (chars.length <= 1) return fgHex(hexStart, text);
  return chars.map((char, i) => {
    const factor = i / (chars.length - 1);
    const color = interpolateColor(hexStart, hexEnd, factor);
    return fgHex(color, char);
  }).join('');
}

