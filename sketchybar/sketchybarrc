#!/usr/bin/env bash
# ==============================================================================
# XENOZ — Caelestia Shell AeroSpace + SketchyBar Glass UI
# Theme: Caelestia Floating Glass Islands / Catppuccin Mocha
# Window Manager: AeroSpace
# Typography: GeistMono Nerd Font
# ==============================================================================

PLUGIN_DIR="$CONFIG_DIR/plugins"

##### 1. Global Bar Properties — Caelestia Floating Bar #####
sketchybar --bar \
    position=top \
    height=38 \
    margin=12 \
    blur_radius=35 \
    color=0x4011111b \
    border_color=0x35cba6f7 \
    border_width=1 \
    corner_radius=16 \
    padding_left=14 \
    padding_right=14 \
    display=main

##### 2. Default Item Configuration #####
default=(
    padding_left=6
    padding_right=6
    padding_top=0
    icon.font="GeistMono Nerd Font:Bold:14.0"
    label.font="GeistMono Nerd Font:Bold:12.5"
    icon.color=0xffcdd6f4
    label.color=0xffcdd6f4
    icon.padding_left=4
    icon.padding_right=4
    label.padding_left=4
    label.padding_right=4
    background.drawing=off
)
sketchybar --default "${default[@]}"

##### 3. Left Module (Apple Launcher & Frontmost App Island) #####

# Apple Accent Icon / Quick Launcher
sketchybar --add item apple_logo left \
    --set apple_logo \
        icon="" \
        icon.font="GeistMono Nerd Font:Bold:15.5" \
        icon.color=0xffcba6f7 \
        label.drawing=off \
        padding_left=10 \
        padding_right=4 \
        icon.padding_left=2 \
        icon.padding_right=3

# Frontmost Application Name
sketchybar --add item front_app left \
    --set front_app \
        icon.drawing=off \
        label.font="GeistMono Nerd Font:Bold:13.0" \
        label.color=0xffcdd6f4 \
        padding_left=4 \
        padding_right=12 \
        label.padding_left=2 \
        label.padding_right=2 \
        script="$PLUGIN_DIR/front_app.sh" \
    --subscribe front_app front_app_switched

# Bracket: Left Island Capsule
sketchybar --add bracket left_island apple_logo front_app \
    --set left_island \
        padding_left=6 \
        padding_right=12 \
        background.drawing=on \
        background.color=0x351e1e2e \
        background.border_color=0x30cba6f7 \
        background.border_width=1 \
        background.corner_radius=10 \
        background.height=28 \
        background.padding_left=0 \
        background.padding_right=0

##### 4. Center Module (Caelestia Island Workspaces + Sliding Indicator) #####

# Register AeroSpace workspace change event
sketchybar --add event aerospace_workspace_change

# Sliding Floating Glass Pill Indicator (Standalone background layer, zero layout width)
sketchybar --add item workspace_indicator center \
    --set workspace_indicator \
        drawing=on \
        width=0 \
        padding_left=0 \
        padding_right=0 \
        icon.drawing=off \
        label.drawing=off \
        background.drawing=on \
        background.color=0x45cba6f7 \
        background.border_color=0x80cba6f7 \
        background.border_width=1 \
        background.corner_radius=7 \
        background.height=24 \
        background.padding_left=11 \
        background.padding_right=11 \
        background.x_offset=0 \
        z_position=background \
        script="$PLUGIN_DIR/workspace_indicator.sh" \
    --subscribe workspace_indicator aerospace_workspace_change mouse.scrolled

# Query all workspaces from AeroSpace (fallback 1..8)
SPACES=($(aerospace list-workspaces --all 2>/dev/null))
if [ ${#SPACES[@]} -eq 0 ]; then
    SPACES=(1 2 3 4 5 6 7 8)
fi

SPACE_BRACKET_ITEMS=()
TOTAL_SPACES=${#SPACES[@]}

# Add each workspace item with clean symmetrical spacing
for i in "${!SPACES[@]}"; do
    sid="${SPACES[$i]}"
    SPACE_BRACKET_ITEMS+=("space.$sid")

    PL=3
    PR=3
    if [ "$i" -eq 0 ]; then
        PL=6
    fi
    if [ "$i" -eq $((TOTAL_SPACES - 1)) ]; then
        PR=6
    fi

    sketchybar --add item "space.$sid" center \
        --set "space.$sid" \
            icon="$sid" \
            icon.font="GeistMono Nerd Font:Bold:13.0" \
            icon.color=0xff6c7086 \
            icon.highlight_color=0xffffffff \
            icon.padding_left=6 \
            icon.padding_right=6 \
            padding_left="$PL" \
            padding_right="$PR" \
            label.drawing=off \
            background.drawing=off \
            click_script="aerospace workspace $sid" \
            script="$PLUGIN_DIR/space.sh $sid" \
        --subscribe "space.$sid" mouse.entered mouse.exited mouse.exited.global mouse.scrolled
done

# Bracket: Center Workspaces Island Capsule (strictly groups spaces, completely fixed width)
sketchybar --add bracket center_island "${SPACE_BRACKET_ITEMS[@]}" \
    --set center_island \
        padding_left=12 \
        padding_right=12 \
        background.drawing=on \
        background.color=0x351e1e2e \
        background.border_color=0x30cba6f7 \
        background.border_width=1 \
        background.corner_radius=10 \
        background.height=28 \
        background.padding_left=0 \
        background.padding_right=0

##### 5. Right Modules (Generous Margins for Wi-Fi & System Controls) #####

# 1. Spotify Player Capsule (Auto-hides when idle)
sketchybar --add item spotify right \
    --set spotify \
        icon="󰝚" \
        icon.color=0xffa6e3a1 \
        label.color=0xffcdd6f4 \
        label.font="GeistMono Nerd Font:Medium:12.0" \
        padding_left=10 \
        padding_right=10 \
        icon.padding_left=3 \
        icon.padding_right=5 \
        label.padding_left=3 \
        label.padding_right=3 \
        update_freq=5 \
        click_script="open -a Spotify 2>/dev/null || true" \
        script="$PLUGIN_DIR/spotify.sh"

sketchybar --add bracket spotify_island spotify \
    --set spotify_island \
        padding_left=6 \
        padding_right=6 \
        background.drawing=on \
        background.color=0x351e1e2e \
        background.border_color=0x25a6e3a1 \
        background.border_width=1 \
        background.corner_radius=10 \
        background.height=28 \
        background.padding_left=0 \
        background.padding_right=0

# 2. Hardware Performance Island (CPU & RAM)
sketchybar --add item cpu right \
    --set cpu \
        icon="󰍛" \
        icon.color=0xff89b4fa \
        label.color=0xffcdd6f4 \
        label.font="GeistMono Nerd Font:Bold:12.5" \
        padding_left=10 \
        padding_right=5 \
        icon.padding_left=2 \
        icon.padding_right=4 \
        label.padding_left=2 \
        label.padding_right=2 \
        update_freq=4 \
        script="$PLUGIN_DIR/cpu.sh"

sketchybar --add item memory right \
    --set memory \
        icon="󰘚" \
        icon.color=0xfffab387 \
        label.color=0xffcdd6f4 \
        label.font="GeistMono Nerd Font:Bold:12.5" \
        padding_left=5 \
        padding_right=10 \
        icon.padding_left=2 \
        icon.padding_right=4 \
        label.padding_left=2 \
        label.padding_right=2 \
        update_freq=5 \
        script="$PLUGIN_DIR/memory.sh"

sketchybar --add bracket stats_island cpu memory \
    --set stats_island \
        padding_left=6 \
        padding_right=6 \
        background.drawing=on \
        background.color=0x351e1e2e \
        background.border_color=0x20ffffff \
        background.border_width=1 \
        background.corner_radius=10 \
        background.height=28 \
        background.padding_left=0 \
        background.padding_right=0

# 3. Wi-Fi / Network Island (Dedicated capsule with generous margins)
sketchybar --add item network right \
    --set network \
        icon="󰖩" \
        icon.color=0xffa6e3a1 \
        label.color=0xffcdd6f4 \
        label.font="GeistMono Nerd Font:Bold:12.5" \
        padding_left=10 \
        padding_right=10 \
        icon.padding_left=3 \
        icon.padding_right=5 \
        label.padding_left=3 \
        label.padding_right=3 \
        update_freq=10 \
        click_script="open /System/Library/PreferencePanes/Network.prefPane 2>/dev/null || true" \
        script="$PLUGIN_DIR/network.sh" \
    --subscribe network wifi_change

sketchybar --add bracket network_island network \
    --set network_island \
        padding_left=6 \
        padding_right=6 \
        background.drawing=on \
        background.color=0x351e1e2e \
        background.border_color=0x25a6e3a1 \
        background.border_width=1 \
        background.corner_radius=10 \
        background.height=28 \
        background.padding_left=0 \
        background.padding_right=0

# 4. Volume & Audio Module
sketchybar --add item volume right \
    --set volume \
        icon="󰕾" \
        icon.color=0xffcba6f7 \
        label.color=0xffcdd6f4 \
        label.font="GeistMono Nerd Font:Bold:12.5" \
        padding_left=10 \
        padding_right=10 \
        icon.padding_left=3 \
        icon.padding_right=5 \
        label.padding_left=3 \
        label.padding_right=3 \
        click_script="open /System/Library/PreferencePanes/Sound.prefPane 2>/dev/null || true" \
        script="$PLUGIN_DIR/volume.sh" \
    --subscribe volume volume_change

sketchybar --add bracket volume_island volume \
    --set volume_island \
        padding_left=6 \
        padding_right=6 \
        background.drawing=on \
        background.color=0x351e1e2e \
        background.border_color=0x20ffffff \
        background.border_width=1 \
        background.corner_radius=10 \
        background.height=28 \
        background.padding_left=0 \
        background.padding_right=0

# 5. Battery & Power Module
sketchybar --add item battery right \
    --set battery \
        icon="󰁹" \
        icon.color=0xffa6e3a1 \
        label.color=0xffcdd6f4 \
        label.font="GeistMono Nerd Font:Bold:12.5" \
        padding_left=10 \
        padding_right=10 \
        icon.padding_left=3 \
        icon.padding_right=5 \
        label.padding_left=3 \
        label.padding_right=3 \
        update_freq=60 \
        click_script="open /System/Library/PreferencePanes/EnergySaver.prefPane 2>/dev/null || true" \
        script="$PLUGIN_DIR/battery.sh" \
    --subscribe battery system_woke power_source_change

sketchybar --add bracket battery_island battery \
    --set battery_island \
        padding_left=6 \
        padding_right=6 \
        background.drawing=on \
        background.color=0x351e1e2e \
        background.border_color=0x20ffffff \
        background.border_width=1 \
        background.corner_radius=10 \
        background.height=28 \
        background.padding_left=0 \
        background.padding_right=0

# 6. Clock Module (24-Hour)
sketchybar --add item clock right \
    --set clock \
        icon="󰥔" \
        icon.color=0xffcba6f7 \
        label.color=0xffcdd6f4 \
        label.font="GeistMono Nerd Font:Bold:12.5" \
        padding_left=10 \
        padding_right=12 \
        icon.padding_left=3 \
        icon.padding_right=5 \
        label.padding_left=3 \
        label.padding_right=3 \
        update_freq=10 \
        click_script="open -a Calendar 2>/dev/null || true" \
        script="$PLUGIN_DIR/clock.sh"

sketchybar --add bracket clock_island clock \
    --set clock_island \
        padding_left=6 \
        padding_right=6 \
        background.drawing=on \
        background.color=0x351e1e2e \
        background.border_color=0x20ffffff \
        background.border_width=1 \
        background.corner_radius=10 \
        background.height=28 \
        background.padding_left=0 \
        background.padding_right=0

# Dynamic Wallpaper Theme Listener
sketchybar --add item wallpaper_theme right \
    --set wallpaper_theme \
        drawing=off \
        update_freq=5 \
        script="$CONFIG_DIR/theme/wallpaper_theme.sh"

##### 6. Initial Placement & Synchronization #####
# Instantly place sliding capsule at focused workspace on startup
INIT=true lua "$CONFIG_DIR/lua/workspace.lua"

# Force initialize all plugins
sketchybar --update
